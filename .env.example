# Copie ce fichier en .env et remplis-le. Le fichier .env reste sur ton PC (il n'est jamais partagé).

# Clé API ElevenLabs : elevenlabs.io > Developers > API Keys
ELEVENLABS_API_KEY=

# Identifiant de la voix de Milo (voix sur mesure créée avec Voice Design)
ELEVENLABS_VOIX=

# Modèle (optionnel) : eleven_multilingual_v2 (meilleure qualité) ou eleven_flash_v2_5 (plus rapide, moins cher)
# ELEVENLABS_MODELE=eleven_multilingual_v2

# Voix en essai (page /essai-voix.html), séparées par des virgules
# ELEVENLABS_VOIX_ESSAI=

# Sans activation explicite : lecture des fichiers en cache et voix de l'appareil.
LUMO_VOIX_GENERATION=0
# Plafond quotidien persistant, partagé par les processus sur la même base.
LUMO_VOIX_CARACTERES_JOUR=2000
LUMO_FUSEAU=Europe/Brussels
